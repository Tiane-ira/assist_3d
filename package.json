{
  "name": "assist_3d",
  "version": "0.3.0",
  "author": {
    "name": "xrj"
  },
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "win": "electron-vite build && electron-builder --win",
    "mac": "electron-vite build && electron-builder --mac",
    "icon": "electron-icon-builder --input=./public/icon.png --output=build --flatten",
    "lint": "eslint . --ext .ts,.vue"
  },
  "dependencies": {
    "element-plus": "^2.10.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^28.1.0",
    "electron-builder": "^24.13.0",
    "electron-devtools-installer": "^3.2.0",
    "electron-icon-builder": "^2.0.1",
    "electron-store": "^8.2.0",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.30.0",
    "sass": "^1.80.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vue-tsc": "^2.0.0"
  },
  "engines": {
    "node": ">= 18"
  },
  "build": {
    "productName": "assist_3d",
    "appId": "assist_3d",
    "copyright": "Copyright © year 2023",
    "artifactName": "assist3d_Setup_${version}_${platform}.${ext}",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["ia32"]
        }
      ]
    },
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icons/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "./build/icons/icon.ico",
      "uninstallerIcon": "./build/icons/icon.ico",
      "installerHeaderIcon": "./build/icons/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "assist_3d",
      "runAfterFinish": true
    },
    "dmg": {
      "icon": "build/icons/icon.icns"
    }
  }
}
